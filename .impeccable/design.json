  "narrative": {
    "northStar": "One Calm Shell Session",
    "overview": "The course is drawn as a single shell session on a phosphor terminal, after bissbert.ch: a tmux window bar, a neofetch home, lessons opened with cat, a vim-style status line. It is a costume, not a shell: nothing accepts commands, every piece of terminal furniture is a link or a read-only readout. Dark only.",
    "keyCharacteristics": [
      "One screen colour, phosphor green for the frame, ANSI hues for meaning.",
      "VT323 for frame and headings, JetBrains Mono for reading and code.",
      "Square corners, no glow, no drop shadows; a faint scanline overlay.",
      "Shell idiom carries structure: #, ##, [ ], //."
    ],
    "rules": [
      "One meaning per hue.",
      "Green is the frame, never body text.",
      "Red only for compiler errors and reset.",
      "No working prompt."
    ],
    "dos": [
      "Use shell idiom for structure.",
      "Keep every terminal element clickable or read-only and self-explanatory.",
      "Snap the ASCII logo to whole-pixel sizes."
